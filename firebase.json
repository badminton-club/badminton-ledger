{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "gmail",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        ".secret*",
        "*.log",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": "ui/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/gmail/**",
        "function": {
          "functionId": "gmailApi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
