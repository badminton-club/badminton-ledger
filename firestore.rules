rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Club membership helpers ─────────────────────────────────────────────────
    function isMember(clubId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }
    function memberRole(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role;
    }
    function isClubAdmin(clubId) {
      return isMember(clubId) && (memberRole(clubId) == 'admin' || memberRole(clubId) == 'superAdmin');
    }
    function isClubSuperAdmin(clubId) {
      return isMember(clubId) && memberRole(clubId) == 'superAdmin';
    }
    // The player a member is linked to ('' when unlinked) — used so a member can read
    // only their own balance-ledger entries.
    function memberPlayerId(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.get('playerId', '');
    }
    // Bootstrap: whoever created the club (its ownerUid) can grant themselves the
    // first admin membership before any admin exists.
    function isClubOwner(clubId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read:   if isMember(clubId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // ownerUid must never change after creation — it's what lets the original
      // creator bootstrap the first superAdmin membership (see isClubOwner above
      // and the members bootstrap clause below). Without this, any regular admin
      // could rewrite ownerUid to a second account they control and use that
      // account's now-true isClubOwner() to self-grant superAdmin, bypassing the
      // "only superadmins may grant elevated roles" invariant entirely.
      allow update: if isClubAdmin(clubId)
        && request.resource.data.ownerUid == resource.data.get('ownerUid', null);
      allow delete: if isClubSuperAdmin(clubId);

      // Membership roster. Only superadmins may create/change/remove elevated roles
      // (admin/superAdmin). Regular admins may add plain members and edit any
      // member's non-role fields (e.g. player links) — they just can't change roles.
      match /members/{uid} {
        allow read:   if isSignedIn() && (request.auth.uid == uid || isClubAdmin(clubId));
        allow create: if isClubSuperAdmin(clubId)
          || (request.auth.uid == uid && isClubOwner(clubId))
          || (isClubAdmin(clubId) && request.resource.data.role == 'member')
          || (
            request.auth.uid == uid
            && request.resource.data.acceptedInviteId is string
            && exists(/databases/$(database)/documents/clubInvitations/$(request.resource.data.acceptedInviteId))
            && get(/databases/$(database)/documents/clubInvitations/$(request.resource.data.acceptedInviteId)).data.clubId == clubId
            && request.auth.token.email_verified == true
            && get(/databases/$(database)/documents/clubInvitations/$(request.resource.data.acceptedInviteId)).data.email == request.auth.token.email.lower()
            && request.resource.data.role == get(/databases/$(database)/documents/clubInvitations/$(request.resource.data.acceptedInviteId)).data.role
            && request.resource.data.get('playerId', null) == get(/databases/$(database)/documents/clubInvitations/$(request.resource.data.acceptedInviteId)).data.get('playerId', null)
          );
        allow update: if isClubSuperAdmin(clubId)
          || (isClubAdmin(clubId) && request.resource.data.role == resource.data.role);
        allow delete: if isClubSuperAdmin(clubId);
      }

      // Link requests: a user manages their own request; admins read/resolve any.
      match /linkRequests/{uid} {
        allow read:           if isSignedIn() && (request.auth.uid == uid || isClubAdmin(clubId));
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete:         if isClubAdmin(clubId) || request.auth.uid == uid;
      }

      // Profile edit requests: a linked member proposes a name/email change here
      // for an admin to review and apply — same shape as linkRequests above,
      // except create/update also requires the proposal target their OWN linked
      // player. Without this, any member could write a proposedEdit for someone
      // ELSE's playerId and have an admin unknowingly approve it against the
      // wrong player.
      match /profileEditRequests/{uid} {
        allow read:           if isSignedIn() && (request.auth.uid == uid || isClubAdmin(clubId));
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && isMember(clubId) && request.resource.data.playerId == memberPlayerId(clubId);
        allow delete:         if isClubAdmin(clubId) || request.auth.uid == uid;
      }

      // Calendar data: any member may read; only admins may write.
      match /sessions/{doc} { allow read: if isMember(clubId); allow write: if isClubAdmin(clubId); }
      match /players/{doc} {
        allow read:   if isMember(clubId);
        allow create, delete: if isClubAdmin(clubId);
        // Only admins edit players — a member proposes name/email changes via
        // profileEditRequests above instead of writing directly.
        allow update: if isClubAdmin(clubId);
      }

      // Financial / inventory data: admins only.
      match /birdieInventory/{doc}       { allow read, write: if isClubAdmin(clubId); }
      match /courtCredits/{doc}          { allow read, write: if isClubAdmin(clubId); }
      match /inventoryAdjustments/{doc}  { allow read, write: if isClubAdmin(clubId); }
      match /transactions/{doc}          { allow read, write: if isClubAdmin(clubId); }
      // Members may read only their own linked player's ledger; admins read/write all.
      match /balanceLedger/{doc} {
        allow read: if isClubAdmin(clubId)
          || (isMember(clubId) && resource.data.playerId == memberPlayerId(clubId));
        allow write: if isClubAdmin(clubId);
      }
      match /archivedSessions/{doc}      { allow read, write: if isClubAdmin(clubId); }
      match /payouts/{doc}               { allow read, write: if isClubAdmin(clubId); }
      // Gmail e-Transfer autodeposit import review queue + remembered sender→player
      // mappings — admins only, same as other financial data.
      match /etransferImports/{doc}        { allow read, write: if isClubAdmin(clubId); }
      match /etransferSenderMappings/{doc} { allow read, write: if isClubAdmin(clubId); }
    }

    // One-time email invitations. Admins manage invitations for their club; the
    // intended recipient can read and consume only their own invitation.
    match /clubInvitations/{invitationId} {
      allow create: if isSignedIn()
        && request.resource.data.clubId is string
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.role == 'member' && isClubAdmin(request.resource.data.clubId))
          || (request.resource.data.role == 'admin' && isClubSuperAdmin(request.resource.data.clubId))
        );
      allow read: if isSignedIn() && (
        isClubAdmin(resource.data.clubId)
        || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email.lower())
      );
      allow update: if false;
      allow delete: if isSignedIn() && (
        isClubAdmin(resource.data.clubId)
        || (
          request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower()
          && getAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)/members/$(request.auth.uid)).data.acceptedInviteId == invitationId
        )
      );
    }

    // ── User profiles ──────────────────────────────────────────────────────────
    // Each user manages their own profile (their saved club list + default).
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && (
        request.auth.uid == uid
        // A club admin may initialize only the saved-club list for a user who
        // does not have a profile yet.
        || (
          request.resource.data.keys().hasOnly(['clubs'])
          && request.resource.data.clubs.size() == 1
          && isClubAdmin(request.resource.data.clubs[0])
        )
      );
      allow update: if isSignedIn() && (
        request.auth.uid == uid
        // A club admin granting someone membership (see clubs.ts `addClubMember`)
        // also needs their club to show up in that member's own club switcher —
        // otherwise it only appears once the member separately opens a share
        // link. Scoped tightly so an admin can't touch anything else on another
        // user's profile: only the `clubs` field may change, only by appending
        // exactly one id, and only a club the caller actually administers.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubs'])
          && (
            // Keep retries/idempotent syncs harmless when the club is already saved.
            request.resource.data.clubs == resource.data.get('clubs', [])
            || (
              request.resource.data.clubs.size() == resource.data.get('clubs', []).size() + 1
              && isClubAdmin(request.resource.data.clubs.removeAll(resource.data.get('clubs', []))[0])
            )
          )
        )
      );
    }

    // ── Deny everything else ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
